# PostgreSQL connection. Local default matches docker-compose.yml below.
# On Vercel, set DATABASE_URL in Project → Settings → Environment Variables.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/layers?schema=public"

# Session signing secret (change in production)
SESSION_SECRET="layers-wholesale-crm-dev-secret-change-me"

# Domain restriction for sign-in
ALLOWED_EMAIL_DOMAIN="layerswholesale.com"

# Guards the one-shot /api/seed?key=... endpoint used after a fresh deploy
SEED_SECRET="seed-me-please"
