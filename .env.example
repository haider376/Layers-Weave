# Copy to .env for local development:  cp .env.example .env
#
# PostgreSQL connection. The localhost default matches docker-compose.yml.
# On Vercel, DO NOT rely on this file — set these in
# Project → Settings → Environment Variables instead.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/layers?schema=public"

# Session signing secret — use a long random string in production
SESSION_SECRET="layers-wholesale-crm-dev-secret-change-me"

# Sign-in is restricted to this email domain
ALLOWED_EMAIL_DOMAIN="layerswholesale.com"

# Guards the one-shot /api/seed?key=... endpoint used after a fresh deploy
SEED_SECRET="seed-me-please"
