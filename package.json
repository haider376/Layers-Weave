{
  "name": "layers-weave-crm",
  "version": "1.0.0",
  "private": true,
  "description": "Layers Wholesale CRM — unified Sales → Supply → Logistics system",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
